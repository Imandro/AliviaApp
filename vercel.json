{
  "crons": [
    {
      "path": "/api/notifications/dispatch",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
