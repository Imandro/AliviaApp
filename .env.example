# API URL for native shells (Capacitor/iOS WKWebView)
# After AWS deployment, set this to your Lambda Function URL
VITE_API_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws

# TTS origin. The voice endpoint runs in a separate Lambda OUTSIDE the VPC so it
# can reach Bing/Google without a NAT Gateway (~$32/month). Leave empty to reuse
# VITE_API_URL.
VITE_TTS_URL=https://your-tts-lambda-url.lambda-url.us-east-1.on.aws

# --- AI (VIA) ----------------------------------------------------------------
# Provider hibrido: el chat va a OpenAI (mejor en espanol) y la voz a Groq
# (Whisper v3 turbo cuesta $0.04/hora, unas 9x mas barato que en OpenAI).
#
# En produccion las dos claves viven en Secrets Manager y las lee la Lambda
# alivia-ai (OPENAI_API_KEY y GROQ_API_KEY). El navegador nunca las ve: habla con
# /api/ai/*. Nada de lo que sigue hace falta para un deploy normal.
#
# Si falta OPENAI_API_KEY en la Lambda, el chat cae a Groq automaticamente.
#
# VITE_OPENAI_MODEL acepta una lista de failover separada por comas:
#   VITE_OPENAI_MODEL=gpt-4.1-mini,gpt-4.1-nano,gpt-4o-mini
#
# Desarrollo local contra los proveedores, saltando el proxy. Esto mete las
# claves dentro del bundle JS: NUNCA para un build que se publique.
# VITE_AI_DIRECT=1
# VITE_OPENAI_API_KEY=sk-proj_your_key_here
# VITE_GROQ_API_KEY=gsk_your_key_here