# API URL for native shells (Capacitor/iOS WKWebView)
# After AWS deployment, set this to your Lambda Function URL
VITE_API_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws

# TTS origin. The voice endpoint runs in a separate Lambda OUTSIDE the VPC so it
# can reach Bing/Google without a NAT Gateway (~$32/month). Leave empty to reuse
# VITE_API_URL.
VITE_TTS_URL=https://your-tts-lambda-url.lambda-url.us-east-1.on.aws

# --- AI (VIA) ----------------------------------------------------------------
# In production the Groq key lives in Secrets Manager and is read by the AI
# Lambda (GROQ_API_KEY), never by the browser. The app talks to /api/ai/*, which
# that Lambda serves. Nothing below is needed for a normal deploy.
#
# VITE_GROQ_MODEL accepts a comma-separated failover list, tried in order:
#   VITE_GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b
#
# Local development against Groq directly, bypassing the proxy. This inlines the
# key into the JS bundle, so NEVER enable it for a build you ship.
# VITE_GROQ_API_KEY=gsk_your_key_here
# VITE_AI_DIRECT=1